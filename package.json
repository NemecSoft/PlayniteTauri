{
  "name": "yungame",
  "version": "0.2.0",
  "private": true,
  "description": "Playnite desktop app rewritten with Tauri (Rust + React 19 + TypeScript + Vite 8)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "auto-build": "node scripts/auto-build.mjs",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build:admin": "tsc -p tsconfig.admin.json && vite build --config vite.admin.config.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "i18next": "^26.3.6",
    "lucide-react": "^0.441.0",
    "pinyin-pro": "^3.28.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  }
}
