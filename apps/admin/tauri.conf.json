{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Playnite.Admin",
  "version": "10.0.0",
  "identifier": "yungame.admin",
  "build": {
    "beforeDevCommand": "npm run dev:admin",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build:admin",
    "frontendDist": "../../dist-admin"
  },
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "label": "admin",
        "title": "YunGame 管理端",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}